<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.godview</groupId>
  <artifactId>godview</artifactId>
  <version>1.1.0</version>
  <packaging>jar</packaging>

  <name>GodView</name>
  <description>Realtime web operations console for Paper servers.</description>

  <properties>
    <java.version>21</java.version>
    <!-- Downloaded by Paper's library loader at runtime, never shaded. Declared here so
         plugin.yml can be filtered from one place and so tests get the real driver. -->
    <sqlite.version>3.46.1.3</sqlite.version>

    <!-- The panel is a Vue app under panel/, built into the jar by the frontend
         plugin below. Node is downloaded into target/ rather than taken from the
         machine, so the same jar comes out of any checkout and CI needs nothing
         installed. Skip it with -Dgodview.panel.skip=true when working on the
         Java side; the server then serves its API-only placeholder page. -->
    <node.version>v22.11.0</node.version>
    <godview.panel.skip>false</godview.panel.skip>
    <junit.version>5.11.4</junit.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>playpro</id>
      <url>https://maven.playpro.com</url>
    </repository>
    <repository>
      <id>extendedclip</id>
      <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- Compiled against the oldest 1.21 so one jar runs unchanged across the whole
         1.21.x line, up to and including 1.21.11. Anything added later - the 1.21.3
         Attribute registry rename, Paper's cheaper counters - is reached reflectively
         through dev.godview.compat.Compat rather than by raising this floor.

         1.21 is also where Minecraft itself requires Java 21, which is why java.version
         above matches. Targeting 17 would buy back 1.20.1-1.20.4 and nothing else. -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>1.21.1-R0.1-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>

    <!-- Optional integrations. All guarded by class-presence checks at runtime,
         so a missing plugin never breaks anything. -->
    <dependency>
      <groupId>net.luckperms</groupId>
      <artifactId>api</artifactId>
      <version>5.4</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>net.coreprotect</groupId>
      <artifactId>coreprotect</artifactId>
      <version>22.4</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>me.clip</groupId>
      <artifactId>placeholderapi</artifactId>
      <version>2.11.6</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>

    <!-- provided: the library loader supplies this at runtime from plugin.yml. Present
         at build time only so the storage layer compiles against a real driver. -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Already on the server classpath; used for the live console tail.

         The version must track the log4j-api that paper-api pulls in. Mixing a newer core
         with an older api breaks at class-load time (Configurator against a moved
         StackLocatorUtil signature, for one), which does not show up in a plain compile
         and only surfaces when something actually attaches an appender. Only stable
         AbstractAppender/LogEvent APIs are used, so this links fine against the newer
         log4j a real server ships. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>2.17.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>GodView-${project.version}</finalName>
    <defaultGoal>clean package</defaultGoal>

    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>plugin.yml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>plugin.yml</exclude>
        </excludes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${java.version}</release>
          <compilerArgs>
            <!-- Warnings stay on so a real one is visible. Anything we knowingly do
                 against a legacy Bukkit API is suppressed at the call site instead. -->
            <arg>-Xlint:all,-options,-processing</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
      </plugin>

      <!-- The suites bind real sockets, open real SQLite files and attach a real
           Log4j appender, so they run in one JVM sequentially rather than forked
           per class. Headless is set because the map renderer touches AWT to
           encode PNGs, and a CI box has no display. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <argLine>-Djava.awt.headless=true -Duser.language=en -Duser.country=US</argLine>
          <forkCount>1</forkCount>
          <reuseForks>true</reuseForks>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <!-- Pinned only so `clean` resolves the same way on a cold repo as everything else. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.3.2</version>
      </plugin>

      <!-- Builds the Vue panel straight into target/classes/web, so `mvn package`
           produces one jar with the server and its console in it. Vite is
           configured to emit no inline scripts: GodView serves the panel under a
           CSP without 'unsafe-inline', and a bundler that inlined its bootstrap
           would produce a blank page that works perfectly in `npm run dev`. -->
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>1.15.1</version>
        <configuration>
          <workingDirectory>panel</workingDirectory>
          <installDirectory>${project.build.directory}</installDirectory>
          <skip>${godview.panel.skip}</skip>
        </configuration>
        <executions>
          <execution>
            <id>install-node</id>
            <goals><goal>install-node-and-npm</goal></goals>
            <configuration>
              <nodeVersion>${node.version}</nodeVersion>
            </configuration>
          </execution>
          <execution>
            <id>panel-dependencies</id>
            <goals><goal>npm</goal></goals>
            <configuration>
              <!-- ci, not install: the lockfile is the build input, and a
                   dependency quietly floating to a new minor between two builds
                   of the same commit is not something a plugin jar should do. -->
              <arguments>ci --no-audit --no-fund</arguments>
            </configuration>
          </execution>
          <execution>
            <id>panel-build</id>
            <!-- process-classes, not prepare-package: the panel is a build output the
                 tests legitimately assert on, and the test phase runs first. Building
                 it later meant `mvn test` checked a directory that did not exist yet. -->
            <phase>process-classes</phase>
            <goals><goal>npm</goal></goals>
            <configuration>
              <arguments>run build</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
